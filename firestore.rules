rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // [헬퍼 함수]
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // 1. 하드코딩된 이메일/UID 체크 (초기 설정용)
      // 2. users 컬렉션의 role 필드 체크 (ABAC)
      return isAuthenticated() && (
        request.auth.token.email_verified == true && (
          request.auth.token.email == "cskim1747@gmail.com" || 
          request.auth.token.email == "jco119@gmail.com" ||
          request.auth.uid == "3H9K9FXktGgDrxEkm6zqzGWoaxf1" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    // 0. 회원 정보: 본인만 수정 가능, 읽기는 본인 또는 관리자
    match /users/{userId} {
      function isOwner(uid) {
        return isAuthenticated() && request.auth.uid == uid;
      }
      
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin(); // 실제 삭제는 관리자만
    }

    // 1. 가격 정보: 누구나 읽기 가능, 관리자만 수정
    match /pricing/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. 견적/상담 요청: 로그인 사용자만 생성 가능, 읽기는 '본인' 또는 '관리자'
    match /quotes/{quoteId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow update, delete: if isAdmin();
    }

    // 4. 공지사항: 누구나 읽기 가능, 관리자만 쓰기/수정/삭제 가능
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. 골퍼 명언: 누구나 읽기 가능, 관리자만 쓰기/수정/삭제 가능
    match /golferQuotes/{quoteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. 챗봇 데이터: 누구나 읽기 가능, 관리자만 수정
    match /chatting/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. NFC 데스크 세션: 누구나 읽고, 쓰기는 관리자만 가능 (NFC 임시 전송용)
    match /active_sessions/{document=**} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 8. 갤러리 관련: 누구나 읽기 가능, 관리자만 수정
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videoGallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 9. FAQ: 누구나 읽기 가능, 관리자만 수정
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. 설정 정보: 누구나 읽기 가능, 관리자만 수정
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}